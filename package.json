{
  "name": "personal-expense-tracker",
  "version": "1.0.0",
  "description": "Personal Expense Tracker MERN Application",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\" --names \"API,WEB\" --prefix-colors \"yellow,cyan\"",
    "start": "npm run dev",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "test:db": "npm --prefix backend run test:db",
    "export:db": "npm --prefix backend run export:db",
    "import:db": "npm --prefix backend run import:db",
    "mongo:local": "node backend/scripts/run-mongo.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
